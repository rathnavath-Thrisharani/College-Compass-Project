generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      =env("DATABASE_URL")
  }

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  savedColleges SavedCollege[]
}

model College {
  id            String   @id @default(cuid())
  name          String
  location      String
  fees          Int
  rating        Float
  placementRate Float
  avgPackage    Float
  description   String
  website       String?

  imageUrl      String?
  logoUrl       String?

  courses Course[]
  reviews Review[]
  savedBy SavedCollege[]
}

model Course {
  id        String @id @default(cuid())
  name      String
  duration  String
  fees      Int

  collegeId String
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}

model Review {
  id        String @id @default(cuid())
  rating    Int
  comment   String

  collegeId String
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}

model SavedCollege {
  id        String @id @default(cuid())

  userId    String
  collegeId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
}

